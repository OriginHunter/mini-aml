<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miniaml.mapper.SuspiciousCaseMapper">

    <!-- 注意：resultType 要写你的 VO 全路径 -->
    <select id="selectCaseListWithDetails" resultType="com.miniaml.dto.SuspiciousCaseVO">
        SELECT
        sc.case_no AS caseNo,
        sc.rule_name AS ruleName,
        t.amount AS amount,
        a.account_no AS accountNo,
        c.name AS customerName
        FROM suspicious_case sc
        <!-- 1. 关联交易表：条件 sc.transaction_id = t.id -->
        LEFT JOIN `transaction` t ON sc.transaction_id = t.id

        <!-- 2. 关联账户表：条件 t.account_id = a.id -->
        LEFT JOIN account a ON t.account_id = a.id

        <!-- 3. 关联客户表：条件 a.customer_id = c.id -->
        LEFT JOIN customer c ON a.customer_id = c.id

        <where>
            <!-- 4. 动态 SQL：如果传了 caseNo（不为空），就拼上 AND sc.case_no = #{caseNo} -->
            <if test="caseNo != null and caseNo != ''">
                AND sc.case_no = #{caseNo}
            </if>
        </where>
    </select>
</mapper>